{
  "name": "rentrhythm",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke:invoice": "tsx --env-file-if-exists=.env scripts/smoke-invoice.ts",
    "agent": "tsx --env-file-if-exists=.env scripts/agent.ts",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "send-invoice": "tsx --env-file-if-exists=.env scripts/send-invoice.ts",
    "register-webhook": "tsx --env-file-if-exists=.env scripts/register-webhook.ts",
    "start:render": "tsx scripts/seed.ts --if-empty && next start",
    "predev": "node scripts/copy-bryntum.mjs",
    "prebuild": "node scripts/copy-bryntum.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.109",
    "@bryntum/calendar": "npm:@bryntum/calendar-trial@7.3.8",
    "@paypal/agent-toolkit": "1.11.0",
    "ai": "7.0.158",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
